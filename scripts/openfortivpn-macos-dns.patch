+bool ipv4_has_vpn_default_route(const struct tunnel *tunnel)
+{
+	struct rtentry route;
+	route_init(&route);
+	route_iface(&route) = strdup(tunnel->ppp_iface);
+	if (route_iface(&route) == NULL)
+		return false;
+	bool found = ipv4_get_route(&route) == 0 &&
+	             route_dest(&route).s_addr == INADDR_ANY &&
+	             route_mask(&route).s_addr == INADDR_ANY && (route.rt_flags & RTF_UP) &&
+	             !(route.rt_flags & (RTF_REJECT | RTF_BLACKHOLE));
+	route_destroy(&route);
+	return found;
+}
+
